{
  "name": "Multi-language Development",
  "forwardPorts": [
    8080
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "eriklynd.json-tools",
        "DavidAnson.vscode-markdownlint",
        "adamhartford.vscode-base64",
        "redhat.vscode-xml",
        "DotJoshJohnson.xml",
        "redhat.vscode-yaml",
        "vmware.vscode-boot-dev-pack",
        "vmware.vscode-spring-boot",
        "vscjava.vscode-spring-initializr",
        "redhat.java",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-test",
        "vscjava.vscode-maven",
        "vscjava.vscode-java-dependency",
        "SonarSource.sonarlint-vscode",
        "redhat.vscode-quarkus",
        "redhat.fabric8-analytics",
        "redhat.vscode-microprofile"
      ],
      "settings": {
        "[dockercompose]": {
          "editor.autoIndent": "advanced",
          "editor.defaultFormatter": "redhat.vscode-yaml",
          "editor.insertSpaces": true,
          "editor.quickSuggestions": {
            "comments": false,
            "other": true,
            "strings": true
          },
          "editor.tabSize": 2
        },
        "[github-actions-workflow]": {
          "editor.defaultFormatter": "redhat.vscode-yaml"
        },
        "[markdown]": {
          "diffEditor.ignoreTrimWhitespace": false
        },
        "[xml]": {
          "editor.defaultFormatter": "DotJoshJohnson.xml"
        },
        "[yaml]": {
          "diffEditor.ignoreTrimWhitespace": false,
          "editor.autoIndent": "keep",
          "editor.defaultColorDecorators": "never",
          "editor.insertSpaces": true,
          "editor.quickSuggestions": {
            "comments": false,
            "other": true,
            "strings": true
          },
          "editor.tabSize": 2
        },
        "boot-java.highlight-codelens.on": true,
        "boot-java.validation.cron": "ON",
        "boot-java.validation.data-query": "ON",
        "boot-java.validation.java.boot2": "AUTO",
        "boot-java.validation.java.boot3": "AUTO",
        "boot-java.validation.java.boot4": "AUTO",
        "boot-java.validation.java.spring-aot": "ON",
        "boot-java.validation.java.version-validation": "ON",
        "boot-java.validation.spel.on": "ON",
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.accessibilitySupport": "off",
        "editor.autoIndent": "advanced",
        "editor.codeActionsOnSave": {
          "source.fixAll": "never",
          "source.organizeImports": "explicit"
        },
        "editor.detectIndentation": false,
        "editor.fontLigatures": true,
        "editor.glyphMargin": true,
        "editor.indentSize": "tabSize",
        "editor.largeFileOptimizations": true,
        "editor.minimap.enabled": false,
        "editor.mouseWheelZoom": true,
        "editor.renderControlCharacters": false,
        "editor.renderWhitespace": "none",
        "editor.suggestSelection": "first",
        "editor.tabSize": 2,
        "explorer.decorations.badges": false,
        "explorer.decorations.colors": false,
        "extensions.ignoreRecommendations": false,
        "files.associations": {
          "*.log": "log"
        },
        "files.exclude": {
          "**/.classpath": true,
          "**/.factorypath": true,
          "**/.project": true,
          "**/.settings": true
        },
        "git.confirmSync": false,
        "git.enableSmartCommit": true,
        "git.openRepositoryInParentFolders": "never",
        "github.copilot.nextEditSuggestions.enabled": true,
        "html.format.indentHandlebars": true,
        "html.format.indentInnerHtml": true,
        "ipynb.experimental.serialization": false,
        "ipynb.pasteImagesAsAttachments.enabled": false,
        "java.autobuild.enabled": false,
        "java.cleanup.actions": [
          "qualifyMembers",
          "addOverride",
          "addDeprecated",
          "stringConcatToTextBlock",
          "invertEquals",
          "instanceofPatternMatch",
          "lambdaExpression",
          "lambdaExpressionFromAnonymousClass",
          "switchExpression",
          "tryWithResource",
          "renameFileToType",
          "useSwitchForInstanceofPattern"
        ],
        "java.codeAction.sortMembers.avoidVolatileChanges": true,
        "java.codeGeneration.addFinalForNewDeclaration": "none",
        "java.codeGeneration.generateComments": false,
        "java.codeGeneration.hashCodeEquals.useInstanceof": false,
        "java.codeGeneration.hashCodeEquals.useJava7Objects": true,
        "java.codeGeneration.insertionLocation": "lastMember",
        "java.codeGeneration.toString.codeStyle": "STRING_CONCATENATION",
        "java.codeGeneration.toString.limitElements": 0,
        "java.codeGeneration.toString.listArrayContents": true,
        "java.codeGeneration.toString.skipNullValues": false,
        "java.codeGeneration.useBlocks": false,
        "java.compile.nullAnalysis.mode": "disabled",
        "java.completion.chain.enabled": true,
        "java.completion.enabled": true,
        "java.completion.favoriteStaticMembers": [
          "org.hamcrest.Matchers.*",
          "org.awaitility.Awaitility.*",
          "org.assertj.core.api.Assertions.*",
          "org.junit.Assert.*",
          "org.junit.Assume.*",
          "org.junit.jupiter.api.Assertions.*",
          "org.junit.jupiter.api.Assumptions.*",
          "org.junit.jupiter.api.DynamicContainer.*",
          "org.junit.jupiter.api.DynamicTest.*",
          "org.mockito.Mockito.*",
          "org.mockito.ArgumentMatchers.*",
          "org.mockito.Answers.*"
        ],
        "java.completion.guessMethodArguments": "auto",
        "java.completion.importOrder": [
          "java",
          "jakarta",
          "javax",
          "com",
          "org"
        ],
        "java.completion.matchCase": "firstLetter",
        "java.completion.maxResults": 100,
        "java.completion.postfix.enabled": true,
        "java.configuration.maven.userSettings": "~/.m2/settings.xml",
        "java.configuration.runtimes": [
          {
            "default": true,
            "name": "JavaSE-25",
            "path": "/usr/lib/jvm/java-25-openjdk"
          }
        ],
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.configuration.workspaceCacheLimit": 1,
        "java.debug.logLevel": "error",
        "java.debug.settings.console": "integratedTerminal",
        "java.debug.settings.enableRunDebugCodeLens": true,
        "java.debug.settings.forceBuildBeforeLaunch": false,
        "java.debug.settings.hotCodeReplace": "auto",
        "java.debug.settings.jdwp.limitOfVariablesPerJdwpRequest": 100,
        "java.debug.settings.jdwp.requestTimeout": 3000,
        "java.debug.settings.maxStringLength": 0,
        "java.debug.settings.onBuildFailureProceed": false,
        "java.debug.settings.showHex": false,
        "java.debug.settings.showLogicalStructure": true,
        "java.debug.settings.showQualifiedNames": true,
        "java.debug.settings.showStaticVariables": true,
        "java.debug.settings.showToString": true,
        "java.debug.settings.stepping.skipConstructors": false,
        "java.debug.settings.stepping.skipStaticInitializers": false,
        "java.debug.settings.stepping.skipSynthetics": false,
        "java.debug.settings.vmArgs": "-Xmx2G -Xms1G",
        "java.dependency.autoRefresh": true,
        "java.dependency.packagePresentation": "hierarchical",
        "java.dependency.refreshDelay": 15000,
        "java.dependency.showMembers": true,
        "java.dependency.syncWithFolderExplorer": true,
        "java.eclipse.downloadSources": false,
        "java.editor.reloadChangedSources": "ask",
        "java.errors.incompleteClasspath.severity": "error",
        "java.foldingRange.enabled": false,
        "java.format.comments.enabled": true,
        "java.format.enabled": true,
        "java.format.onType.enabled": true,
        "java.format.settings.profile": "GoogleStyle",
        "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
        "java.implementationCodeLens": "all",
        "java.import.generatesMetadataFilesAtProjectRoot": true,
        "java.import.maven.enabled": true,
        "java.inlayHints.parameterNames.enabled": "literals",
        "java.jdt.ls.lombokSupport.enabled": true,
        "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms500m",
        "java.maven.downloadSources": false,
        "java.maven.updateSnapshots": false,
        "java.maxConcurrentBuilds": 1,
        "java.quickfix.showAt": "line",
        "java.referencesCodeLens.enabled": true,
        "java.saveActions.cleanup": true,
        "java.saveActions.organizeImports": false,
        "java.server.launchMode": "Hybrid",
        "java.showBuildStatusOnStart.enabled": "notification",
        "java.signatureHelp.description.enabled": true,
        "java.signatureHelp.enabled": true,
        "java.trace.server": "off",
        "java.typeHierarchy.lazyLoad": true,
        "json.format.enable": true,
        "json.validate.enable": true,
        "markdown.updateLinksOnFileMove.enabled": "prompt",
        "markdown.validate.enabled": true,
        "material-icon-theme.folders.theme": "specific",
        "maven.dependency.enableConflictDiagnostics": true,
        "maven.pomfile.autoUpdateEffectivePOM": true,
        "maven.pomfile.prefetchEffectivePom": true,
        "maven.showInExplorerContextMenu": true,
        "maven.terminal.customEnv": [
          {
            "environmentVariable": "MAVEN_OPTS",
            "value": "-Xms256m -Xmx512m"
          }
        ],
        "maven.terminal.useJavaHome": true,
        "maven.view": "hierarchical",
        "quarkus.tools.alwaysShowWelcomePage": false,
        "quarkus.tools.debug.terminateProcessOnExit": "Ask",
        "security.workspace.trust.untrustedFiles": "open",
        "sonarlint.automaticAnalysis": true,
        "sonarlint.disableTelemetry": true,
        "sonarlint.focusOnNewCode": false,
        "sonarlint.ls.javaHome": "/usr/lib/jvm/java-25-openjdk",
        "sonarlint.output.showVerboseLogs": false,
        "sonarlint.rules": {
          "java:S107": {
            "level": "off"
          }
        },
        "sonarlint.trace.server": "off",
        "spring-boot.ls.checkJVM": true,
        "spring.initializr.defaultArtifactId": "spring-app",
        "spring.initializr.defaultGroupId": "com.sample",
        "spring.initializr.defaultJavaVersion": "11",
        "spring.initializr.defaultLanguage": "Java",
        "spring.initializr.defaultOpenProjectMethod": "Open",
        "spring.initializr.defaultPackaging": "JAR",
        "spring.initializr.parentFolder": "artifactId",
        "spring.initializr.serviceUrl": [
          "https://start.spring.io"
        ],
        "telemetry.feedback.enabled": false,
        "telemetry.telemetryLevel": "off",
        "window.commandCenter": true,
        "workbench.editor.empty.hint": "hidden",
        "workbench.editor.enablePreview": false,
        "workbench.editorAssociations": {
          "*.copilotmd": "vscode.markdown.preview.editor"
        },
        "workbench.externalBrowser": "chrome",
        "workbench.iconTheme": "material-icon-theme",
        "workbench.startupEditor": "none",
        "workbench.tree.enableStickyScroll": true,
        "workbench.tree.indent": 4,
        "workbench.tree.stickyScrollMaxItemCount": 10,
        "xmlTools.enableXmlTreeView": false,
        "xmlTools.enableXmlTreeViewMetadata": false,
        "xmlTools.enforcePrettySelfClosingTagOnFormat": true,
        "xmlTools.ignoreDefaultNamespace": false,
        "xmlTools.persistXPathQuery": true,
        "xmlTools.removeCommentsOnMinify": false,
        "xmlTools.splitAttributesOnFormat": false,
        "xmlTools.splitXmlnsOnFormat": true,
        "xmlTools.xmlFormatterImplementation": "v2",
        "xmlTools.xqueryExecutionArguments": [
          "-xquery",
          "$(script)",
          "-in",
          "$(input)",
          "-out",
          "$(input).output.xml"
        ],
        "yaml.completion": true,
        "yaml.format.bracketSpacing": true,
        "yaml.format.enable": true,
        "yaml.format.singleQuote": false,
        "yaml.validate": true
      }
    }
  },
  "build": {
    "dockerfile": "Containerfile"
  }
}